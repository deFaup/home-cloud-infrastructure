#!/bin/sh
set -eu

FUNCTION_DIR="/function"

# Create /tmp/tailscale directory for Tailscale state (symlinked from /var/*).
mkdir -p /tmp/tailscale

# Start Tailscale daemon in userspace networking mode with a SOCKS5 proxy.
# Userspace networking is required because Lambda does not provide /dev/net/tun.
${FUNCTION_DIR}/tailscaled \
  --tun=userspace-networking \
  --socks5-server=localhost:1055 \
  --state=/tmp/tailscale/tailscaled.state &
TS_PID=$!

# Wait for tailscaled to create its state file.
TRIES=0
while [ ! -f /tmp/tailscale/tailscaled.state ] && [ $TRIES -lt 30 ]; do
  sleep 0.1
  TRIES=$((TRIES + 1))
done

# Fetch the Tailscale auth key from SSM Parameter Store and write it to disk.
# This must happen before tailscale up, so we do it here rather than in the
# Lambda handler (which starts after tailscale is already connected).
${FUNCTION_DIR}/python ${FUNCTION_DIR}/fetch_authkey.py

# Connect this node to the tailnet using the ephemeral key from SSM.
${FUNCTION_DIR}/tailscale up \
  --auth-key=$(cat /tmp/tailscale-authkey) \
  --hostname=lambda-approve \
  --accept-routes

# Clean up the key file — it is no longer needed.
rm -f /tmp/tailscale-authkey

echo "Tailscale connected"

# ALL_PROXY tells the Python handler to route HTTP requests through the
# Tailscale SOCKS5 proxy so they reach nodes on the tailnet.
export ALL_PROXY=socks5://localhost:1055/

# Start the Lambda Runtime Interface Client.
# _HANDLER is set by Lambda (from the Handler function property) and tells the
# RIE which Python function to invoke.
exec ${FUNCTION_DIR}/python -m awslambdaric ${_HANDLER}
